{
  "name": "sultan-pubg-store-backend",
  "version": "1.0.0",
  "description": "Backend for Sultan Official PUBG Store",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "seed:payment-methods": "ts-node src/scripts/seedPaymentMethods.ts",
    "seed:settings": "ts-node src/scripts/seedSettings.ts",
    "seed:cloudinary": "ts-node src/scripts/seedWithCloudinary.ts",
    "test:cloudinary": "ts-node src/scripts/testCloudinary.ts",
    "seed:all": "npm run seed:admin && npm run seed:payment-methods && npm run seed:settings && npm run seed:cloudinary",
    "test:db": "ts-node src/scripts/testDB.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.6.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/socket.io": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}